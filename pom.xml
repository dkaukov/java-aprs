<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.basepom</groupId>
        <artifactId>basepom-oss</artifactId>
        <version>63</version>
        <relativePath/>
    </parent>

    <groupId>io.github.dkaukov</groupId>
    <artifactId>java-aprs</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>java-aprs</name>
    <description>Platform-independent APRS protocol and domain library</description>
    <url>https://github.com/dkaukov/java-aprs</url>

    <licenses>
        <license>
            <name>GNU General Public License v3.0</name>
            <url>https://www.gnu.org/licenses/gpl-3.0.en.html</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>dkaukov</id>
            <name>Dmitry Kaukov</name>
            <url>https://github.com/dkaukov</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/dkaukov/java-aprs.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/dkaukov/java-aprs.git</developerConnection>
        <url>https://github.com/dkaukov/java-aprs</url>
        <tag>HEAD</tag>
    </scm>

    <properties>
        <!-- Define the remote or target URL configuration for the site plugin. -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.build.targetJdk>8</project.build.targetJdk>
        <basepom.release.profiles>basepom.central-release</basepom.release.profiles>
        <basepom.release.push-changes>true</basepom.release.push-changes>
        <basepom.license.header>license-header.txt</basepom.license.header>
        <dep.junit.version>4.13.2</dep.junit.version>
        <dep.lombok.version>1.18.46</dep.lombok.version>
        <dep.annotations.version>24.1.0</dep.annotations.version>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${dep.lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <configuration>
                    <!-- Analyze all findings, including rules excluded by Basepom. -->
                    <excludeFilterFiles combine.self="override"/>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <version>${dep.lombok.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains</groupId>
            <artifactId>annotations</artifactId>
            <version>${dep.annotations.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${dep.junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
